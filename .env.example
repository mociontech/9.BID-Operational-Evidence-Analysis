# Evius Datahub. Estas variables viven SOLO en el servidor (Netlify > Site configuration > Environment variables).
# Nunca van en el navegador ni en el repositorio. Copia este archivo a .env solo para pruebas locales con `netlify dev`.

# Base del Datahub (termina en /datahub). La URL de desarrollo esta en el .env de la carpeta BID-Evius; produccion: preguntar a Evius.
EVIUS_URL=
# Token Bearer de un usuario administrador de Evius (caduca; renovarlo en Netlify cuando el reporte diga "unauthorized")
EVIUS_TOKEN=
EVIUS_EVENT_ID=
# Etiqueta de origen que Evius muestra para estos registros
EVIUS_SOURCE=
# Solo se envia a Evius cuando vale live. Cualquier otro valor (p. ej. off) descarta los registros sin enviarlos.
# Deja este archivo sin valores: Netlify bloquea el deploy si un valor marcado como secreto aparece en el repositorio.
EVIUS_MODE=
# Una experiencia de Evius por cada boton del totem (iguales en los 12 proyectos)
EVIUS_EXPERIENCE_REBOOT_ID=
EVIUS_EXPERIENCE_RETROCEDER_ID=
EVIUS_EXPERIENCE_PAUSE_ID=
EVIUS_EXPERIENCE_ADELANTAR_ID=
EVIUS_EXPERIENCE_BACK_ID=
# Puntaje que recibe cada pulsacion
EVIUS_SCORE_PER_PRESS=
